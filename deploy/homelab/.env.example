COMPOSE_PROJECT_NAME=syntax-evolution
EVOLUTION_PUBLIC_URL=https://evolution.seudominio.com.br
EVOLUTION_API_KEY=
EVOLUTION_DB_PASSWORD=
# Only loopback diagnostics are published; HTTPS enters through proxy or tunnel.
EVOLUTION_BIND_IP=127.0.0.1
EVOLUTION_LOCAL_PORT=8085
# Used only with --profile https. Requires a public IP and incoming ports 80/443.
EVOLUTION_DOMAIN=evolution.seudominio.com.br
# Used only with --profile tunnel. Configure its public hostname -> http://evolution:8080.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
