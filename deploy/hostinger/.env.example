APP_NAME=SyntaxAtendimento
APP_ENV=production
APP_DEBUG=false
# Preserve the existing APP_KEY when migrating a database with encrypted credentials.
APP_KEY=
APP_URL=https://api-atendimento.seudominio.com.br
FRONTEND_URL=https://atendimento.seudominio.com.br
CORS_ALLOWED_ORIGINS=https://atendimento.seudominio.com.br
SANCTUM_STATEFUL_DOMAINS=atendimento.seudominio.com.br
SESSION_SECURE_COOKIE=true
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
CACHE_DRIVER=file
SESSION_DRIVER=file
FILESYSTEM_DISK=public
# No Horizon, Redis or persistent worker is required on the shared host.
QUEUE_CONNECTION=sync
WHATSAPP_PROVIDER=evolution
WHATSAPP_COUNTRY_CODE=55
EVOLUTION_API_URL=https://evolution.seudominio.com.br
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
# Base URL only; do not append /api. Evolution will call the public Laravel API.
EVOLUTION_WEBHOOK_BASE_URL=https://api-atendimento.seudominio.com.br
# A send also queries the connection first. Check the host's request time limit.
EVOLUTION_SEND_TIMEOUT=25
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SyntaxAtendimento
GOOGLE_CLIENT_ID=
MERCADO_PAGO_CONNECT_REDIRECT_URI=https://api-atendimento.seudominio.com.br/api/integrations/mercado-pago/oauth/callback
